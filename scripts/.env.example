# Supabase — for npm run db:seed. Use local Supabase by default (supabase start).
SEED_SUPABASE_URL=http://127.0.0.1:54321
SEED_SUPABASE_SECRET_KEY=your_local_supabase_secret_key_here

# Set SEED_ALLOW_REMOTE=true to run seed against a non-localhost DB.
# This script WIPES all users + jobs — use with extreme caution.
# SEED_ALLOW_REMOTE=false
