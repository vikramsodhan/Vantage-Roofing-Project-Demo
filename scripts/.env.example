# Supabase — for npm run db:seed. Use local Supabase by default (supabase start).
SEED_SUPABASE_URL=http://127.0.0.1:54321
SEED_SUPABASE_SECRET_KEY=your_local_supabase_secret_key_here

# Set SEED_ALLOW_REMOTE=true to run seed against a non-localhost DB.
# This script WIPES all users + jobs — use with extreme caution.
# SEED_ALLOW_REMOTE=false

# --- npm run demo:reset -------------------------------------------------
# Restores the public demo's data without touching auth accounts, so live
# visitor sessions survive. Normally run by .github/workflows/demo-reseed.yml
# (nightly + manual dispatch); these are only for running it by hand.
#
# It refuses to run against any database holding accounts outside the seeded
# @vantage.test set, so a wrong URL here fails safe rather than wiping a real
# database.
# DEMO_SUPABASE_URL=https://your-demo-project.supabase.co
# DEMO_SUPABASE_SECRET_KEY=your_demo_service_role_key_here
