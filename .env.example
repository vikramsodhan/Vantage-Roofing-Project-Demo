# Supabase — get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Domain restriction for OAuth (Google account picker)
NEXT_PUBLIC_ALLOWED_DOMAIN=your-company.ca

# Development mode — enables dev login form (hard-gated off NODE_ENV in non-production builds)
NEXT_PUBLIC_DEV_MODE=false

# Mapbox — get from mapbox.com account settings
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
