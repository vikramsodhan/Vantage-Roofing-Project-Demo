# Supabase — get these from your Supabase project settings
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key_here

# Domain restriction for OAuth (Google account picker)
NEXT_PUBLIC_ALLOWED_DOMAIN=your-company.ca

# Development mode — enables dev login form (hard-gated off NODE_ENV in non-production builds)
NEXT_PUBLIC_DEV_MODE=false

# Demo mode — adds "Enter as Owner/Manager/Salesperson" buttons to the login
# page, disables the (unusable) Google button, and shows a banner marking the
# data as fabricated. Not gated off NODE_ENV, because the deployed demo is a
# production build — so only ever set it on the demo deployment.
NEXT_PUBLIC_DEMO_MODE=false

# OPTIONAL. The seeded demo accounts' shared password, used both to create them
# (scripts/seed.ts) and to sign in (the demo's server action). Defaults to the
# value in src/lib/demoPassword.ts, so the demo works with this unset.
#
# Not a secret — the demo lets anyone in by design — it exists only so the
# password can be rotated without a commit. If you set it, re-run the seed too,
# or the accounts keep the old one and demo sign-in breaks.
# DEMO_PASSWORD=

# Mapbox — get from mapbox.com account settings
NEXT_PUBLIC_MAPBOX_TOKEN=your_mapbox_token_here
